        <name>Summarize work notes (OpenAI)</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[var inputsPayload = {};
// claim is a input of type: glide_record
inputsPayload['claim'] = {
  tableName: 'x_snc_w_claims_claim',
  sysId: current.getValue('sys_id'),
  queryString: ''
};

var request = {
	executionRequests: [{
		payload: inputsPayload,
		capabilityId: 'c3a753483be4de1062736c1c95e45ae3',
		meta: {
			skillConfigId: '63a7db443b28de1062736c1c95e45a99'
		}
	}], 
	mode: 'sync' 
};

try {
	var response = sn_one_extend.OneExtendUtil.execute(request);
	var capability_response = response.capabilities["c3a753483be4de1062736c1c95e45ae3"].response;
	gs.addInfoMessage(capability_response);
	// var summary = JSON.parse(capability_response).model_output;
	// gs.addInfoMessage('summary');
	current.work_notes = capability_response;
	current.update();
	
} catch(e) {
	gs.error(e);
	gs.addErrorMessage('Something went wrong while executing skill.');
}
action.setRedirectURL(current);]]></script>
